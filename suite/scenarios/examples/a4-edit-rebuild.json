{
  "_goal": "Build a parking lot, edit the build (select it, Edit), move its entrance to the east street, rebuild; before/after pictures from the same cameras.",
  "id": "a4-edit-rebuild",
  "site": "flat",
  "steps": [
    { "do": "area", "tool": "bucket" },
    { "do": "type", "layer": "parking", "preset": "compact" },
    { "do": "entrance", "side": "south", "t": 0.5 },
    { "do": "build" },
    { "do": "camera", "target": "build", "view": "top", "shot": "before-top", "shotMode": "render" },
    { "do": "camera", "target": "entrance", "index": 0, "view": "closeup", "shot": "before-entrance", "shotMode": "render" },
    { "do": "edit", "build": true },
    { "do": "moveEntrance", "index": 0, "side": "east", "t": 0.5 },
    { "do": "preview", "shot": "after-preview" },
    { "do": "build" },
    { "do": "camera", "target": "build", "view": "top", "shot": "after-top", "shotMode": "render" },
    { "do": "camera", "target": "entrance", "index": 0, "view": "closeup", "shot": "after-entrance", "shotMode": "render" },
    { "do": "camera", "target": "point", "at": [0, -70], "view": "closeup", "shot": "old-entrance-spot", "shotMode": "render" }
  ]
}
