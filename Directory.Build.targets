<Project>
  <!-- Same immutable maps/textures in the game, engine-free tests and real-Core UI mock. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets\Flags\catalog.json" LogicalName="FlowerPainter.Flags.catalog.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets\Flags\maps\*.bin" LogicalName="FlowerPainter.Flags.maps.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Assets\Flags\textures\*.png" LogicalName="FlowerPainter.Flags.textures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
