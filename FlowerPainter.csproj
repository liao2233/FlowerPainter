<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Two build modes:
      * Toolchain mode (CSII_TOOLPATH set by Options > Modding in game): the official
        Mod.props/Mod.targets run the post-processor, Burst and deploy.
      * Standalone mode (no toolchain): compiles against the installed game's own
        Managed assemblies (including its mscorlib) and copies the result to the
        local Mods folder. No Burst, no Entities source generators: the code base
        deliberately avoids SystemAPI/IJobEntity so both modes compile the same sources.
  -->
  <PropertyGroup>
    <AssemblyName>FlowerPainter</AssemblyName>
    <RootNamespace>FlowerPainter</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <Nullable>disable</Nullable>
    <CS2ToolPath Condition="'$(CSII_TOOLPATH)' != ''">$(CSII_TOOLPATH)</CS2ToolPath>
    <CS2ToolPath Condition="'$(CS2ToolPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CS2ToolPath>
    <!-- Opt-in (-p:UseToolchain=true): the code base has no Burst jobs, so standalone output is
         equivalent, and the toolchain's post-processor needs a .NET 6 runtime many machines lack. -->
    <UseToolchain Condition="'$(UseToolchain)' == 'true' AND ('$(CS2ToolPath)' == '' OR !Exists('$(CS2ToolPath)\Mod.props'))">false</UseToolchain>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
  </PropertyGroup>

  <Import Project="$(CS2ToolPath)\Mod.props" Condition="'$(UseToolchain)' == 'true'" />

  <!-- Standalone mode -->
  <PropertyGroup Condition="'$(UseToolchain)' != 'true'">
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <UserDataPath Condition="'$(UserDataPath)' == ''">$(USERPROFILE)\AppData\LocalLow\Colossal Order\Cities Skylines II</UserDataPath>
    <DeployDir>$(UserDataPath)\Mods\$(AssemblyName)</DeployDir>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseToolchain)' != 'true'">
    <Reference Include="mscorlib"><HintPath>$(ManagedPath)\mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(ManagedPath)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(ManagedPath)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedPath)\netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <GameReference Include="System.Drawing;Game;Colossal.Core;Colossal.Collections;Colossal.Logging;Colossal.Localization;Colossal.Mathematics;Colossal.IO.AssetDatabase;Colossal.AssetPipeline;Colossal.UI;Colossal.UI.Binding;Unity.Collections;Unity.Entities;Unity.Mathematics;Unity.Burst;UnityEngine.CoreModule;UnityEngine.ImageConversionModule;UnityEngine.ScreenCaptureModule;Colossal.PSI.Common;UnityEngine.InputLegacyModule;Unity.InputSystem;Newtonsoft.Json;Unity.RenderPipelines.HighDefinition.Runtime;Unity.RenderPipelines.Core.Runtime;cohtml.Net;Cinemachine" />
    <GameReference Include="UnityEngine.IMGUIModule" />
    <Reference Include="@(GameReference)">
      <HintPath Condition="'$(UseToolchain)' != 'true'">$(ManagedPath)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony 2.2.2 (MIT, Library/Harmony/README.md): shipped next to the mod, licence text deployed too. -->
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>Library\Harmony\0Harmony.dll</HintPath><Private>true</Private></Reference>
    <None Include="Library\Harmony\LICENSE" Link="0Harmony-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UI\**;Tests\**;docs\**;bin\**;obj\**;.forensics\**;tools\**;suite\**" />
    <None Remove="UI\**;Tests\**;docs\**" />
    <!-- Output timestamps can come from an older checkout or test bundle. Always ship this checkout's data. -->
    <None Include="Lang\en-US*.json;Lang\zh-HANS*.json" CopyToOutputDirectory="Always" LinkBase="Lang" />
    <None Include="Recipes\*.json" CopyToOutputDirectory="Always" LinkBase="Recipes" />
    <None Include="Recipes\shelf\*.json" CopyToOutputDirectory="Always" LinkBase="Recipes\shelf" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LICENSE')" />
    <None Include="Assets\Flags\*.md;Assets\Flags\extra-sources.json" CopyToOutputDirectory="Always" LinkBase="FlagSources" />
  </ItemGroup>

  <!-- Every build names its commit (the in-game suite records it): InformationalVersion = Version+<short hash>[-dirty]. -->
  <Target Name="FlowerPainterGitVersion" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="FlowerPainterGitHash" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="FlowerPainterGitDirty" />
    </Exec>
    <PropertyGroup>
      <InformationalVersion Condition="'$(FlowerPainterGitHash)' != ''">$(Version)+$(FlowerPainterGitHash)</InformationalVersion>
      <InformationalVersion Condition="'$(FlowerPainterGitHash)' != '' AND '$(FlowerPainterGitDirty)' != ''">$(Version)+$(FlowerPainterGitHash)-dirty</InformationalVersion>
    </PropertyGroup>
  </Target>

  <Import Project="$(CS2ToolPath)\Mod.targets" Condition="'$(UseToolchain)' == 'true'" />

  <!-- UI bundle: built before the C# output is gathered so deploy never ships a stale bundle. -->
  <Target Name="BuildUserInterface" BeforeTargets="BeforeBuild" Condition="'$(SkipUI)' != 'true'">
    <Exec Condition="!Exists('$(MSBuildProjectDirectory)\UI\node_modules\webpack\package.json')" WorkingDirectory="$(MSBuildProjectDirectory)\UI" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\UI" Command="npm run build" EnvironmentVariables="FLOWERPAINTER_UI_OUT=$(MSBuildProjectDirectory)\UI\build" />
  </Target>

  <!-- Mods\FlowerPainter is shared with the game queue: tools\suite\Deploy-Mod.ps1 installs under the queue's install lock,
       refuses while a game runs or a queue game owns the folder, and swaps a staged copy in (never a half-written folder).
       -p:Deploy=false builds without installing. -->
  <Target Name="DeployStandalone" AfterTargets="Build" Condition="'$(UseToolchain)' != 'true' AND '$(Deploy)' != 'false'">
    <PropertyGroup>
      <FlowerPainterOutFull>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)'))).TrimEnd('\'))</FlowerPainterOutFull>
      <FlowerPainterDeployTo>$(DeployDir.TrimEnd('\'))</FlowerPainterDeployTo>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\suite\Deploy-Mod.ps1&quot; -From &quot;$(FlowerPainterOutFull)&quot; -Ui &quot;$(MSBuildProjectDirectory)\UI\build&quot; -To &quot;$(FlowerPainterDeployTo)&quot;" CustomErrorRegularExpression="FlowerPainter was NOT installed" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="high" />
  </Target>

  <Target Name="DeployUserInterface" AfterTargets="DeployWIP" Condition="'$(UseToolchain)' == 'true'">
    <ItemGroup>
      <FlowerPainterUiTc Include="$(MSBuildProjectDirectory)\UI\build\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FlowerPainterUiTc)" DestinationFiles="@(FlowerPainterUiTc->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
