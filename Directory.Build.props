<Project>
  <PropertyGroup>
    <!-- Release version: UI and publishing metadata are checked against this value. -->
    <Version>0.1.4</Version>
    <Deploy Condition="'$(Deploy)' == ''">false</Deploy>
    <ManagedPath Condition="'$(ManagedPath)' == '' And '$(FLOWERPAINTER_GAME_DIR)' != ''">$(FLOWERPAINTER_GAME_DIR)\Cities2_Data\Managed</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == '' And Exists('$(MSBuildThisFileDirectory)..\Cities2_Data\Managed\Game.dll')">$(MSBuildThisFileDirectory)..\Cities2_Data\Managed</ManagedPath>
  </PropertyGroup>
</Project>
